{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "edit": "allow",
    "webfetch": "ask",
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm test*": "allow",
      "npm run test*": "allow",
      "node --test*": "allow",
      "git push*": "deny",
      "git reset --hard*": "deny",
      "rm -rf*": "deny"
    }
  }
}
